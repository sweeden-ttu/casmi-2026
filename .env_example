# =============================================================================
# Enveda CASMI 2026 — Environment & Secrets Configuration (.env)
# Used by: notebooks/03_colab_eda_and_model_zoo_dashboard.ipynb
#          casmi26/benchmark.py (setup_colab_and_kaggle_secrets)
# =============================================================================
# Place this file in:
#   - Local workspace: /mnt/LMSTUDIO/CASMI/.env
#   - Google Drive (for Colab): /content/drive/MyDrive/CASMI2026/.env
# =============================================================================

# 1. Kaggle API Credentials (Required)
# Obtain from: Kaggle -> Settings -> Account -> API -> Create New Token (kaggle.json)
KAGGLE_USERNAME=""
KAGGLE_KEY=""
KAGGLE_API_TOKEN=""

# 2. Target Kaggle Dataset Slug for Model Export (Recommended)
KAGGLE_MODEL_DATASET_SLUG="sweeden/casmi26-trained-models"

# 3. Evidently Cloud / Workspace API Token (Recommended)
# Used by Cell 6 (`log_weights_and_biases_to_evidently`) to record model weights,
# biases, feature attributions, and MRR@25 benchmark reports.
EVIDENTLY_TOKEN=""

# 4. Hugging Face Read Token (Recommended)
# Used for pulling pretrained mass spectrometry & chemistry checkpoints
# (DreaMS, MassSpecGym, NPComposer, GP-MoLFormer, ChemBERTa).
HF_TOKEN=""

# 5. GitHub Personal Access Token (Optional)
# Used if pushing updated benchmark metrics directly from Colab to sweeden-ttu/casmi-2026.
GITHUB_TOKEN=""
